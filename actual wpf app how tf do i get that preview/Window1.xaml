        Title="Window 1"
        Height="400"
        Width="200"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Opacity="0.6">

    <Grid>
        <Grid.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Color="Black" Opacity="0.5"/>
