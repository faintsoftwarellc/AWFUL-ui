        <RibbonCheckBox Content="EXAMPLE CHECKBOX"
                         FontSize="8"
                         FontWeight="Bold"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top" Height="20" Width="18" Margin="-1,46,0,0"/>
        <TextBlock
                   FontSize="16"
                   FontWeight="UltraLight"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" Height="78" Width="56" Margin="16,46,0,0" Background="Bisque" Opacity="0.5" TextWrapping="WrapWithOverflow" Text="example text">
        </TextBlock>
        <TextBlock Text="Settings page" FontSize="20" FontWeight="Bold" Height="33" Width="213" Margin="6,7,-19,360" Foreground="Beige"/>
    </Grid>
</Window>
