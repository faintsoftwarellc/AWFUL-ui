<Window x:Class="actual_wpf_app_how_tf_do_i_get_that_preview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:actual_wpf_app_how_tf_do_i_get_that_preview"
        mc:Ignorable="d"
        Title="Injector 6967"
        Height="450"
        Width="400"
        Opacity="0.6"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Border BorderThickness="1"
            BorderBrush="Black"
            CornerRadius="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="2,2">
                <GradientStop Color="Purple" Offset="1"/>
                <GradientStop Color="DarkGray" Offset="0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Cursor="Pen"
                    CornerRadius="10,10,0,0"
                    Opacity="0.5">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="2,2">
                        <GradientStop Color="Purple" Offset="1"/>
                        <GradientStop Color="DarkGray" Offset="0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <TextBlock VerticalAlignment="Center"
                           Margin="8,0"
                           FontWeight="Bold"
                           Foreground="Black"
                           Text="Injector UI concept(Please give credit)">
                    <TextBlock.Effect>
                        <BlurEffect Radius="3"
                                    KernelType="Gaussian"
                                    RenderingBias="Quality"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>

            <Grid Grid.Row="1">
                <Grid.Effect>
                    <DropShadowEffect/>
                </Grid.Effect>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="87*" />
                    <ColumnDefinition Width="113*" />
                </Grid.ColumnDefinitions>

                <Button Content="Other"
                        Width="35"
                        Height="64"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0,10,0,0"
                        Click="OpenSidePanel_Click"
                        Opacity="0.1"
                        BorderBrush="Transparent"/>

                <Button Background="LightGreen"
                        Margin="43,363,11,13"
                        Grid.Column="1"
                        Click="Button_Click">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>

                    <TextBlock Text="Inject"
                               FontFamily="Segoe UI"
                               FontSize="20"
                               FontWeight="Bold"/>
                </Button>

                <Grid Grid.Column="1"
                      Margin="43,326,11,58"
                      Height="30"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="35" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SelectedDllTextBox"
                             Text="DLL Name(none selected)"
                             IsReadOnly="True"
                             FontSize="11"
                             VerticalContentAlignment="Center"
                             Foreground="Black"
                             Opacity="0.8"/>

                    <Button Grid.Column="1"
                            Content="..."
                            FontWeight="Bold"
                            Click="SelectDll_Click"/>
                </Grid>

                <Button Background="LightCoral"
                        Margin="134,39,10,355"
                        Grid.Column="1"
                        Click="Button_Click_1"
                        Opacity="0.9">
                    <TextBlock Text="Refresh"
                               FontStyle="Italic"
                               Opacity="0.6"/>
                </Button>

                <ComboBox Margin="69,10,10,384"
                          Grid.Column="1">
                    <ComboBoxItem Opacity="0.7"
                                  Background="DarkGray">
                        <StackPanel Orientation="Horizontal">
                            <Border BorderThickness="1"
                                    BorderBrush="Black">
                                <Image Source="C:\Users\chanc\source\repos\actual wpf app how tf do i get that preview\actual wpf app how tf do i get that preview\OIP.jpeg"
                                       Height="20"
                                       Width="20"
                                       Stretch="UniformToFill"/>
                            </Border>

                            <TextBlock Text="Example process"
                                       Foreground="DarkBlue"/>
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <Border x:Name="SidePanel"
                        Width="190"
                        Background="DarkGray"
                        Opacity="0.7"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        Grid.ColumnSpan="2">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Content="X"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,5,5,0"
                                FontWeight="Bold"
                                Background="LightCoral"
                                Foreground="Black"
                                Click="CloseSidePanel_Click"/>

                        <StackPanel Grid.Row="1"
                                    Margin="20"
                                    VerticalAlignment="Center">

                            <Button Content="Settings"
                                    Height="30"
                                    Margin="0,-300,0,15"
                                    Click="OpenWindow1_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF4CAF50" Offset="1"/>
                                        <GradientStop Color="#FF1B5E20" Offset="0"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>

                            <Button Content="About Author(ui)"
                                    Height="30"
                                    Click="OpenWindow2_Click"
                                    Margin="0,-200,0,15">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF4CAF50" Offset="1"/>
                                        <GradientStop Color="#FF1B5E20" Offset="0"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
