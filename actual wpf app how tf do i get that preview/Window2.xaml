<Window x:Class="actual_wpf_app_how_tf_do_i_get_that_preview.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window 2"
        Height="183"
        Width="107"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Opacity="0.5">

    <Grid Background="LightGray">
        <StackPanel>
            <TextBlock Text="Hi! This UI is a demo by faintsoftwarellc@gmail.com I'm new to UI development."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Width="103"
                           TextWrapping="WrapWithOverflow"
                           FontFamily="Yu Gothic Medium"
                           FontSize="8"
                           Height="120"/>

            <Button Content="Github"
                    Height="30"
                    FontSize="8"
                    Click="OpenLinkButton_Click">
                <Button.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="DarkGray" Offset="1.3"/>
                        <GradientStop Color="Purple" Offset="0.4"/>
                    </RadialGradientBrush>
                </Button.Background>

            </Button>
        </StackPanel>
    </Grid>
</Window>
